<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_scheduledReminders" targetNamespace="https://itmo.ru/blps/lab4" exporter="Camunda Modeler" exporterVersion="5.28.0">
  <bpmn:process id="scheduledReminders" name="Напоминания" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="timer" name="По расписанию">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>R/PT1M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="sendReminders" name="Напоминания" camunda:type="external" camunda:topic="sendReminders" />
    <bpmn:endEvent id="end" name="Готово" />
    <bpmn:sequenceFlow id="flow_timer_sendReminders" sourceRef="timer" targetRef="sendReminders" />
    <bpmn:sequenceFlow id="flow_sendReminders_end" sourceRef="sendReminders" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_scheduledReminders">
    <bpmndi:BPMNPlane id="Plane_scheduledReminders" bpmnElement="scheduledReminders">
      <bpmndi:BPMNShape id="timer_di" bpmnElement="timer">
        <dc:Bounds x="80" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sendReminders_di" bpmnElement="sendReminders">
        <dc:Bounds x="320" y="100" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="560" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_timer_sendReminders_di" bpmnElement="flow_timer_sendReminders">
        <di:waypoint x="116" y="118.0" />
        <di:waypoint x="320" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sendReminders_end_di" bpmnElement="flow_sendReminders_end">
        <di:waypoint x="480" y="140.0" />
        <di:waypoint x="560" y="118.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
