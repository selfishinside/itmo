<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_reminderNotification" targetNamespace="https://itmo.ru/blps/lab4" exporter="Camunda Modeler" exporterVersion="5.28.0">
  <bpmn:process id="reminderNotification" name="Напомнить о заезде через Bitrix" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="start" name="Событие Kafka" />
    <bpmn:serviceTask id="notifyReminder" name="Напомнить о заезде через Bitrix" camunda:type="external" camunda:topic="notifyReminder" />
    <bpmn:endEvent id="end" name="Обработано" />
    <bpmn:sequenceFlow id="flow_start_notifyReminder" sourceRef="start" targetRef="notifyReminder" />
    <bpmn:sequenceFlow id="flow_notifyReminder_end" sourceRef="notifyReminder" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_reminderNotification">
    <bpmndi:BPMNPlane id="Plane_reminderNotification" bpmnElement="reminderNotification">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="80" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyReminder_di" bpmnElement="notifyReminder">
        <dc:Bounds x="320" y="100" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="560" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_notifyReminder_di" bpmnElement="flow_start_notifyReminder">
        <di:waypoint x="116" y="118.0" />
        <di:waypoint x="320" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notifyReminder_end_di" bpmnElement="flow_notifyReminder_end">
        <di:waypoint x="480" y="140.0" />
        <di:waypoint x="560" y="118.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>