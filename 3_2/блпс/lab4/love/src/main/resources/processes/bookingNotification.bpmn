<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_bookingNotification" targetNamespace="https://itmo.ru/blps/lab4" exporter="Camunda Modeler" exporterVersion="5.28.0">
  <bpmn:process id="bookingNotification" name="Уведомить о брони через Bitrix" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="start" name="Событие Kafka" />
    <bpmn:serviceTask id="notifyBooking" name="Уведомить о брони через Bitrix" camunda:type="external" camunda:topic="notifyBooking" />
    <bpmn:endEvent id="end" name="Обработано" />
    <bpmn:sequenceFlow id="flow_start_notifyBooking" sourceRef="start" targetRef="notifyBooking" />
    <bpmn:sequenceFlow id="flow_notifyBooking_end" sourceRef="notifyBooking" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_bookingNotification">
    <bpmndi:BPMNPlane id="Plane_bookingNotification" bpmnElement="bookingNotification">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="80" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyBooking_di" bpmnElement="notifyBooking">
        <dc:Bounds x="320" y="100" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="560" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_notifyBooking_di" bpmnElement="flow_start_notifyBooking">
        <di:waypoint x="116" y="118.0" />
        <di:waypoint x="320" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notifyBooking_end_di" bpmnElement="flow_notifyBooking_end">
        <di:waypoint x="480" y="140.0" />
        <di:waypoint x="560" y="118.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>