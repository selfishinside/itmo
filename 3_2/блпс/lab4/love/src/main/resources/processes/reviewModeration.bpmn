<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_reviewModeration" targetNamespace="https://itmo.ru/blps/lab4" exporter="Camunda Modeler" exporterVersion="5.28.0">
  <bpmn:process id="reviewModeration" name="Модерация и публикация отзыва" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="start" name="Событие Kafka" />
    <bpmn:serviceTask id="inspectReview" name="Загрузить отзыв" camunda:type="external" camunda:topic="inspectReview" />
    <bpmn:exclusiveGateway id="pendingDecision" name="Нужна модерация?" />
    <bpmn:exclusiveGateway id="spamDecision" name="Содержит spam?" />
    <bpmn:serviceTask id="rejectReview" name="Отклонить отзыв" camunda:type="external" camunda:topic="rejectReview" />
    <bpmn:serviceTask id="publishReview" name="Опубликовать в Bitrix" camunda:type="external" camunda:topic="publishReview" />
    <bpmn:serviceTask id="refreshRating" name="Обновить рейтинг отеля" camunda:type="external" camunda:topic="refreshRating" />
    <bpmn:endEvent id="end" name="Обработано" />
    <bpmn:sequenceFlow id="flow_start_inspectReview" sourceRef="start" targetRef="inspectReview" />
    <bpmn:sequenceFlow id="flow_inspectReview_pendingDecision" sourceRef="inspectReview" targetRef="pendingDecision" />
    <bpmn:sequenceFlow id="flow_rejectReview_refreshRating" sourceRef="rejectReview" targetRef="refreshRating" />
    <bpmn:sequenceFlow id="flow_publishReview_refreshRating" sourceRef="publishReview" targetRef="refreshRating" />
    <bpmn:sequenceFlow id="flow_refreshRating_end" sourceRef="refreshRating" targetRef="end" />
    <bpmn:sequenceFlow id="flow_pendingDecision_spamDecision" sourceRef="pendingDecision" targetRef="spamDecision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pending}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_pendingDecision_end" sourceRef="pendingDecision" targetRef="end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!pending}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_spamDecision_rejectReview" sourceRef="spamDecision" targetRef="rejectReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reviewComment != null &amp;&amp; reviewComment.toLowerCase().contains('spam')}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_spamDecision_publishReview" sourceRef="spamDecision" targetRef="publishReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reviewComment == null || !reviewComment.toLowerCase().contains('spam')}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_reviewModeration">
    <bpmndi:BPMNPlane id="Plane_reviewModeration" bpmnElement="reviewModeration">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="80" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inspectReview_di" bpmnElement="inspectReview">
        <dc:Bounds x="320" y="100" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pendingDecision_di" bpmnElement="pendingDecision">
        <dc:Bounds x="560" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="spamDecision_di" bpmnElement="spamDecision">
        <dc:Bounds x="800" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rejectReview_di" bpmnElement="rejectReview">
        <dc:Bounds x="1040" y="100" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="publishReview_di" bpmnElement="publishReview">
        <dc:Bounds x="80" y="280" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="refreshRating_di" bpmnElement="refreshRating">
        <dc:Bounds x="320" y="280" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="560" y="280" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_inspectReview_di" bpmnElement="flow_start_inspectReview">
        <di:waypoint x="116" y="118.0" />
        <di:waypoint x="320" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inspectReview_pendingDecision_di" bpmnElement="flow_inspectReview_pendingDecision">
        <di:waypoint x="480" y="140.0" />
        <di:waypoint x="560" y="125.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rejectReview_refreshRating_di" bpmnElement="flow_rejectReview_refreshRating">
        <di:waypoint x="1200" y="140.0" />
        <di:waypoint x="320" y="320.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_publishReview_refreshRating_di" bpmnElement="flow_publishReview_refreshRating">
        <di:waypoint x="240" y="320.0" />
        <di:waypoint x="320" y="320.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_refreshRating_end_di" bpmnElement="flow_refreshRating_end">
        <di:waypoint x="480" y="320.0" />
        <di:waypoint x="560" y="298.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_pendingDecision_spamDecision_di" bpmnElement="flow_pendingDecision_spamDecision">
        <di:waypoint x="610" y="125.0" />
        <di:waypoint x="800" y="125.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_pendingDecision_end_di" bpmnElement="flow_pendingDecision_end">
        <di:waypoint x="610" y="125.0" />
        <di:waypoint x="560" y="298.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_spamDecision_rejectReview_di" bpmnElement="flow_spamDecision_rejectReview">
        <di:waypoint x="850" y="125.0" />
        <di:waypoint x="1040" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_spamDecision_publishReview_di" bpmnElement="flow_spamDecision_publishReview">
        <di:waypoint x="850" y="125.0" />
        <di:waypoint x="80" y="320.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>