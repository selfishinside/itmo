
SELECT Н_ЛЮДИ.ФАМИЛИЯ, Н_ВЕДОМОСТИ.ЧЛВК_ИД
FROM Н_ВЕДОМОСТИ
RIGHT JOIN Н_ЛЮДИ ON Н_ЛЮДИ.ИД = Н_ВЕДОМОСТИ.ЧЛВК_ИД
WHERE Н_ЛЮДИ.ИД = 117618
  AND Н_ВЕДОМОСТИ.ЧЛВК_ИД > 117219
  AND Н_ВЕДОМОСТИ.ЧЛВК_ИД < 163249;



